{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    // sharp 0.34+ solo publica un default export. Sin esModuleInterop el
    // `import sharp from "sharp"` compila sin quejarse y en runtime resuelve a
    // undefined, porque el .cjs exporta la funcion directamente y no trae
    // .default. Es tambien el valor por defecto del tsconfig que genera Nest.
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "prisma/**/*.ts", "prisma/**/*.json"],
  "exclude": ["node_modules", "dist", "test"]
}
