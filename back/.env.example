# Server Configuration
PORT=4242
NODE_ENV=development

# URLs
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:4242

# Database (used by Prisma)
# For Docker Compose: DATABASE_URL is overridden in docker-compose.yml to use 'db' service
# For local development: postgresql://postgres:postgres@localhost:5432/hoodies
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hoodies

# Database credentials (used by docker-compose.yml to build DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hoodies

# Admin Authentication
# Cuenta unica de administrador. No hay tabla de usuarios ni registro.
# La app NO arranca si falta cualquiera de estas tres variables.
# Generar el hash con:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'tu-clave'
# Generar el secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# OJO: el hash va entre comillas simples. Docker compose interpola los $ del
# formato bcrypt y sin comillas llega truncado al contenedor.
ADMIN_EMAIL=admin@atuestampa.com
ADMIN_PASSWORD_HASH=''
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Almacenamiento de imagenes de diseno
# local = disco (default, para que docker compose funcione sin credenciales)
# s3    = bucket compatible con S3; pensado para Cloudflare R2 (egress $0)
STORAGE_DRIVER=local
# Solo con STORAGE_DRIVER=local. Ruta relativa a back/. Queda fuera de public/
# a proposito: los masters no deben ser descargables adivinando una URL.
STORAGE_LOCAL_ROOT=var/storage
# Solo con STORAGE_DRIVER=s3. La app no arranca si falta alguna.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Dias que sobrevive una imagen subida que nunca llego a una compra.
DESIGN_ASSET_RETENTION_DAYS=7

# Correo al cliente (Resend). Sin estas dos, el recibo no se envia: se registra
# un warning y el webhook sigue devolviendo 200.
# OJO: verificar el dominio (SPF/DKIM) puede tardar un dia; hasta entonces
# Resend solo entrega a la direccion del dueno de la cuenta.
RESEND_API_KEY=
RESEND_FROM_EMAIL=pedidos@tudominio.com

# Minutos que vive un link firmado de descarga del arte.
PRINT_DOWNLOAD_TTL_MINUTES=60

# Mercado Pago Configuration
MERCADOPAGO_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXX
MERCADOPAGO_WEBHOOK_SECRET=
SHIPPING_DEFAULT_COST_COP=20000
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TO_NUMBER=+573000000000
WHATSAPP_CLOUD_API_VERSION=v22.0
